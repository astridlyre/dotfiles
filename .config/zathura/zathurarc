set font "PragmataPro Mono Liga 14"

# Background colors
set default-bg "#FAF2EB"             # Main background (base7)
set statusbar-bg "#E6E4DF"           # Status bar background (base6)
set inputbar-bg "#E6E4DF"            # Input bar background (base6)

# Foreground colors
set default-fg "#1A1918"             # Text color (base0)
set statusbar-fg "#1A1918"           # Status bar text (base0)
set inputbar-fg "#1A1918"            # Input bar text (base0)

# Highlight and selection
set highlight-color "#F27900"        # Highlight color (orange accent)
set highlight-active-color "#595855" # Active highlight (base1)
set completion-bg "#E6E4DF"          # Completion menu background (base6)
set completion-fg "#595855"          # Completion text (base1)
set completion-highlight-bg "#FAF2EB"   # Completion highlight background (base7)
set completion-highlight-fg "#F27900"   # Completion highlight text (orange)

# Recolor mode (for night/low-light reading)
set recolor-darkcolor "#1A1918"      # Light color in recolor mode (base0)
set recolor-lightcolor "#FAF2EB"     # Dark color in recolor mode (base7)
set recolor "true"

# Additional settings
set notification-bg "#F27900"        # Notification background (orange)
set notification-fg "#FAF2EB"        # Notification text (base7)

set sandbox strict
set statusbar-h-padding 0
set statusbar-v-padding 0
set page-padding 1
set selection-clipboard clipboard

map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map r reload
map R rotate
map K zoom in
map J zoom out
map i recolor
map p print

